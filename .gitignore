# Build output
/dist
/out
node_modules
/build
/tmp

# Compiled output of the shared/ workspace module. Regenerated from
# shared/src by `npm run build` (locally via pretest, in CI via
# app-bin/ci-build-shared-hook.sh); never authored or consumed from git.
shared/dist/

# Staged payload. Nothing here is downloaded or authored: the Lex grammar
# (tree-sitter-lex.wasm, queries/) is copied out of the resolved conda env by
# `./bin/shipit stage`, tree-sitter.wasm out of node_modules by
# `npm run copy-wasm`, and the LSP binary is staged into the .vsix at release
# time by shipit's vsix composition.
/resources/lexd-lsp
/resources/lexd-lsp.exe
/resources/tree-sitter-lex.wasm
/resources/tree-sitter.wasm
/resources/queries/

# Staged embedded-language grammars. Not downloaded: parser.wasm,
# highlights.scm and LICENSE are copied out of the official
# `tree-sitter-<lang>` npm deps by `npm run stage-grammars`. The
# sources are lock-pinned dependencies; this staging dir is build
# output.
/resources/embedded-grammars/

